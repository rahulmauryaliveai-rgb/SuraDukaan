// SURA SHOP — Multi-tenant WhatsApp Commerce SaaS
// Every tenant-scoped entity carries shopId. Tenant context is ALWAYS derived
// from the authenticated session server-side — never from client input.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  runtime         = "nodejs"
  engineType      = "client"
  moduleFormat    = "esm"
  previewFeatures = ["driverAdapters", "queryCompiler"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  SHOP_OWNER
  SHOP_MANAGER
  STAFF
}

enum ShopStatus {
  LIVE
  PAUSED
  MAINTENANCE
  SUSPENDED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum EnquirySource {
  PRODUCT_PAGE
  STOREFRONT
  SHARE
}

enum AnalyticsType {
  SHOP_VIEW
  PRODUCT_VIEW
  WHATSAPP_CLICK
  PRODUCT_SHARE
  SHOP_SHARE
  SEARCH
  QR_SCAN
}

model User {
  id           String    @id @default(cuid())
  phone        String    @unique
  name         String?
  email        String?   @unique
  role         UserRole  @default(SHOP_OWNER)
  isActive     Boolean   @default(true)
  onboardedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  shops        ShopMember[]
  otpCodes     OtpCode[]
  auditLogs    AuditLog[]
  notifications Notification[]

  @@index([phone])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  purpose   String   @default("login") // login | register
  attempts  Int      @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?

  @@index([phone, createdAt])
}

model Shop {
  id            String     @id @default(cuid())
  slug          String     @unique
  name          String
  category      String
  description   String?
  city          String?
  state         String?
  pincode       String?
  address       String?
  mapsLink      String?
  phone         String?
  whatsapp      String
  email         String?
  website       String?
  instagram     String?
  facebook      String?
  openingHours  String?
  logoUrl       String?
  coverUrl      String?
  status        ShopStatus @default(LIVE)
  isPublished   Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  theme         ShopTheme?
  members       ShopMember[]
  categories    Category[]
  products      Product[]
  enquiries     Enquiry[]
  analytics     AnalyticsEvent[]
  subscriptions Subscription[]
  domains       ShopDomain[]
  auditLogs     AuditLog[]

  @@index([slug])
  @@index([status])
}

model ShopMember {
  id        String   @id @default(cuid())
  shopId    String
  userId    String
  role      UserRole @default(SHOP_OWNER)
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([userId])
}

model ShopTheme {
  id            String  @id @default(cuid())
  shopId        String  @unique
  template      String  @default("modern") // modern | minimal | retail | fashion | food
  primaryColor  String  @default("#0f766e")
  buttonStyle   String  @default("rounded") // rounded | pill | square
  font          String  @default("inter")   // inter | poppins | dm-sans
  cardStyle     String  @default("shadow")  // shadow | border | flat
  shop          Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model Category {
  id        String    @id @default(cuid())
  shopId    String
  name      String
  slug      String
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([shopId, slug])
  @@index([shopId])
}

model Product {
  id            String    @id @default(cuid())
  shopId        String
  categoryId    String?
  name          String
  slug          String
  description   String?
  price         Decimal   @db.Decimal(12, 2)
  discountPrice Decimal?  @db.Decimal(12, 2)
  sku           String?
  stock         Int?
  brand         String?
  weight        String?
  productCode   String?
  isPublished   Boolean   @default(true)
  inStock       Boolean   @default(true)
  isFeatured    Boolean   @default(false)
  viewCount     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  shop      Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category  Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images    ProductImage[]
  variants  ProductVariant[]
  tags      ProductTag[]
  enquiries Enquiry[]

  @@unique([shopId, slug])
  @@index([shopId, isPublished])
  @@index([shopId, categoryId])
  @@index([shopId, name])
  @@index([shopId, sku])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  isMain    Boolean @default(false)
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  name      String  // e.g. "Size", "Color"
  options   String  // JSON array of options e.g. ["S","M","L"]
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductTag {
  id        String  @id @default(cuid())
  productId String
  tag       String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, tag])
  @@index([tag])
}

model Enquiry {
  id           String        @id @default(cuid())
  shopId       String
  productId    String?
  productName  String?
  variant      String?
  quantity     Int           @default(1)
  source       EnquirySource @default(PRODUCT_PAGE)
  customerNote String?
  createdAt    DateTime      @default(now())
  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
}

model AnalyticsEvent {
  id        String        @id @default(cuid())
  shopId    String
  type      AnalyticsType
  entityId  String?       // productId, categoryId, etc.
  meta      String?       // JSON: query, source, etc. No PII.
  visitorId String?       // anonymous daily-rotating hash
  createdAt DateTime      @default(now())
  shop      Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, type, createdAt])
}

model Plan {
  id            String  @id @default(cuid())
  code          String  @unique // free | starter | business | pro
  name          String
  priceInr      Int     // yearly price in paise-free INR rupees
  productLimit  Int     // -1 = unlimited
  categoryLimit Int     @default(-1)
  hasAnalytics       Boolean @default(false)
  hasAdvancedThemes  Boolean @default(false)
  hasAi              Boolean @default(false)
  hasCustomDomain    Boolean @default(false)
  hasStaffAccounts   Boolean @default(false)
  removeBranding     Boolean @default(false)
  sortOrder     Int     @default(0)
  isActive      Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id        String             @id @default(cuid())
  shopId    String
  planId    String
  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime           @default(now())
  endsAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  shop      Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  plan      Plan               @relation(fields: [planId], references: [id])
  payments  Payment[]

  @@index([shopId, status])
}

model Payment {
  id                String        @id @default(cuid())
  subscriptionId    String
  amountInr         Int
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  provider          String        @default("razorpay")
  providerOrderId   String?
  providerPaymentId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  subscription      Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  invoice           Invoice?
  events            PaymentEvent[]

  @@index([providerOrderId])
}

model PaymentEvent {
  id        String   @id @default(cuid())
  paymentId String
  type      String
  payload   String   // raw JSON payload
  createdAt DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Invoice {
  id        String   @id @default(cuid())
  paymentId String   @unique
  number    String   @unique
  amountInr Int
  issuedAt  DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model ShopDomain {
  id        String   @id @default(cuid())
  shopId    String
  domain    String   @unique
  verified  Boolean  @default(false)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  shopId    String?
  action    String
  entity    String?
  entityId  String?
  meta      String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  shop      Shop?    @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
