# ---- Core ----
DATABASE_URL="postgresql://sura:sura@localhost:5432/surashop?schema=public"
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"
APP_URL="http://localhost:3000"

# ---- OTP / SMS (leave SMS_PROVIDER=mock for development) ----
SMS_PROVIDER="mock"          # mock | msg91 | twilio
SMS_API_KEY=""

# ---- Payments (Razorpay sandbox) ----
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---- Email ----
EMAIL_PROVIDER="mock"        # mock | resend | ses
EMAIL_API_KEY=""

# ---- AI ----
AI_PROVIDER="mock"           # mock | anthropic | openai
AI_API_KEY=""

# ---- File storage (local for dev, s3/r2 for production) ----
STORAGE_PROVIDER="local"     # local | s3
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""
