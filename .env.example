# ============================================================
#  LOCAL DEVELOPMENT
#  Leave DATABASE_URL blank to auto-start the embedded Postgres
#  (start-sura.bat handles everything).
# ============================================================
DATABASE_URL=""
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"
APP_URL="http://localhost:3000"

# ============================================================
#  PRODUCTION (Vercel + Supabase) — set these in Vercel, not here
# ============================================================
# Supabase → Project Settings → Database → Connection string
#   DATABASE_URL = "Transaction pooler" URI (port 6543)
#   DIRECT_URL   = "Direct connection"  URI (port 5432), used for migrations
# DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres"
# DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# ---- OTP / SMS (mock prints the code to the server log) ----
SMS_PROVIDER="mock"          # mock | msg91 | twilio
SMS_API_KEY=""

# ---- Payments (Razorpay; sandbox simulation when blank) ----
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---- Email ----
EMAIL_PROVIDER="mock"        # mock | resend | ses
EMAIL_API_KEY=""

# ---- AI ----
AI_PROVIDER="mock"           # mock | anthropic | openai
AI_API_KEY=""

# ---- File storage ----
# local = disk (dev) · blob = Vercel Blob (prod) · s3 = R2/S3
STORAGE_PROVIDER="local"
# Vercel Blob injects BLOB_READ_WRITE_TOKEN automatically once a store is created.
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""
